{
  "name": "lolit",
  "version": "1.0.1",
  "description": "High-performance template literal engine for JavaScript with built-in directives and zero runtime overhead.",
  "main": "./dist/lolit.cjs",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --bail --verbose test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webarthur/lolit.git"
  },
  "keywords": [
    "templating",
    "template-literals",
    "javascript",
    "html",
    "rendering",
    "directive",
    "static-site",
    "ssr",
    "engine"
  ],
  "exports": {
    "import": "./dist/lolit.mjs",
    "require": "./dist/lolit.cjs"
  },
  "author": "Arthur Ronconi <webarthur@gmail.com> (https://devarthur.com)",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "jest": "^29.7.0",
    "lit-html": "^3.3.0",
    "rollup": "^4.41.0"
  }
}
